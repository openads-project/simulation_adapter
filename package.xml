<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>carla_its_adapter</name>
  <version>0.0.0</version>
  <description>This package contains the CarlaItsAdapterNode that acts as an Converter to the FB-FI definitions and publishes necessary transforms.</description>

  <maintainer email="guido.kueppers@ika.rwth-aachen.de">Guido Küppers</maintainer>
  <author email="christian.geller@ika.rwth-aachen.de">Christian Geller</author>
  <author email="guido.kueppers@ika.rwth-aachen.de">Guido Küppers</author>
  <author email="jean-pierre.busch@ika.rwth-aachen.de">Jean-Pierre Busch</author>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <depend>carla_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>perception_msgs</depend>
  <depend>perception_msgs_utils</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_perception_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_trajectory_planning_msgs</depend>
  <depend>trajectory_planning_msgs</depend>
  <depend>trajectory_planning_msgs_utils</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
